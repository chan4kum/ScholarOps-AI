# Copy to .env. Never commit .env.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional OpenAI fallback for reason/draft when DeepSeek is unset. Put the key only in local .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano-2025-08-07

# Optional Gemini Search grounding for discovery. Put a NEW key only in local .env if the previous one was exposed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

HF_TOKEN=

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

DATABASE_URL=sqlite+pysqlite:///./data/opportunity.db
REDIS_URL=redis://127.0.0.1:6379/0

# 0 disables the paid ceiling. Groq and Ollama never count regardless.
LLM_DAILY_BUDGET_USD=0
GROQ_POLISH_ENABLED=false
OFFLINE=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local dev: bind API to loopback only (see README). Never use 0.0.0.0 without auth.
# API_HOST=127.0.0.1
# API_PORT=8000

# Local folder scanned for PhD documents (PDF, DOCX, MD). Tilde paths supported.
DOCUMENTS_IMPORT_DIR=/Users/chandankumar/Documents/PHD

# Web search: DuckDuckGo is always used (free). Brave then Tavily only if keys exist.
BRAVE_API_KEY=
TAVILY_API_KEY=
DISCOVERY_MIN_RESULTS=8
DISCOVERY_FETCH_LIMIT=12
USE_PLAYWRIGHT=false

# Phase 3 apply. Empty secret → generated under data/apply_signing_secret (not committed).
APPLY_SIGNING_SECRET=
APPLY_TOKEN_TTL_SECONDS=900
# Never enable generic remote HTTP POST.
APPLY_LIVE_SUBMIT=false
# Send as you after HMAC confirm (email SMTP and/or public portal).
APPLY_AS_ME=false
APPLY_PATHFIND=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Phase 4 ops. Groq/Ollama never count toward the budget.
OPS_DISCOVERY_QUERY=funded PhD Responsible AI Agentic AI governance
OPS_HIGH_FIT_THRESHOLD=80
OPS_DEADLINE_DAYS=7
OPS_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GITHUB_TOKEN=
